{
  "$schema": "https://developer.microsoft.com/json-schemas/teams/v1.17/MicrosoftTeams.schema.json",
  "manifestVersion": "1.17",
  "id": "6599e1cb-e9c7-45e5-b7dc-e04ea2bc9bc9",
  "version": "1.0.9",
  "name": {
    "short": "OutlookPauseMan",
    "full": "OutlookPauseMan (アウトルック ポーズマン)"
  },
  "description": {
    "short": "Outlook 送信前チェック",
    "full": "新しい Outlook 用の誤送信防止ツール。送信前に「送信前チェック」ボタンで宛先・件名・本文・外部ドメイン・禁止ワードを確認できます。"
  },
  "developer": {
    "name": "TATSURO HIGUCHI",
    "websiteUrl": "https://github.com/6nfdpbrwqt-ship-it/outlook-pause-man",
    "privacyUrl": "https://github.com/6nfdpbrwqt-ship-it/outlook-pause-man",
    "termsOfUseUrl": "https://github.com/6nfdpbrwqt-ship-it/outlook-pause-man"
  },
  "icons": {
    "outline": "assets/icon-32.png",
    "color": "assets/icon-128.png"
  },
  "accentColor": "#4f7cff",
  "localizationInfo": {
    "defaultLanguageTag": "ja-jp"
  },
  "authorization": {
    "permissions": {
      "resourceSpecific": [
        {
          "name": "MailboxItem.ReadWrite.User",
          "type": "Delegated"
        }
      ]
    }
  },
  "validDomains": [
    "6nfdpbrwqt-ship-it.github.io"
  ],
  "extensions": [
    {
      "requirements": {
        "scopes": ["mail"],
        "capabilities": [
          { "name": "Mailbox", "minVersion": "1.5" }
        ]
      },
      "runtimes": [
        {
          "id": "TaskPaneRuntime",
          "type": "general",
          "code": {
            "page": "https://6nfdpbrwqt-ship-it.github.io/outlook-pause-man/taskpane.html"
          },
          "lifetime": "short",
          "actions": [
            {
              "id": "ShowTaskPane",
              "type": "openPage",
              "view": "homepage"
            }
          ]
        }
      ],
      "ribbons": [
        {
          "contexts": ["mailCompose"],
          "tabs": [
            {
              "id": "pauseManTab",
              "label": "誤送信防止",
              "position": {
                "builtInTabId": "TabDefault",
                "align": "after"
              },
              "groups": [
                {
                  "id": "msgComposeGroup",
                  "label": "誤送信防止",
                  "controls": [
                    {
                      "id": "msgComposeOpenPaneButton",
                      "type": "button",
                      "label": "送信前チェック",
                      "icons": [
                        { "size": 16, "url": "https://6nfdpbrwqt-ship-it.github.io/outlook-pause-man/assets/icon-16.png" },
                        { "size": 32, "url": "https://6nfdpbrwqt-ship-it.github.io/outlook-pause-man/assets/icon-32.png" },
                        { "size": 80, "url": "https://6nfdpbrwqt-ship-it.github.io/outlook-pause-man/assets/icon-80.png" }
                      ],
                      "supertip": {
                        "title": "送信前チェック",
                        "description": "宛先・件名・本文・外部ドメイン・禁止ワードを送信前にチェックします"
                      },
                      "actionId": "ShowTaskPane"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
